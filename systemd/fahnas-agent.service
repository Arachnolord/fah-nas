# fahnas-agent: Steuerdienst mit Rechten (root), hört nur auf dem Unix-Socket /run/fahnas/agent.sock (0660 root:fahnas).
# Härtung bewusst begrenzt, weil der Dienst genau die Root-Aufgaben erledigt, die der Web-Dienst nicht darf:
#  - kein NoNewPrivileges: Dateioperationen laufen per setuid/setgid als der anfragende Nutzer; useradd/chpasswd/smbpasswd.
#  - ProtectKernelTunables=no, ProtectSystem aus: hdparm/smartctl, Schreiben nach /etc (Samba, snapper, nftables, netplan).
#  - ProtectHome aus: Freigaben liegen unter /data, Nutzerdaten könnten gesucht werden.
#  - Group=fahnas: das RuntimeDirectory /run/fahnas gehört damit root:fahnas, der Web-Dienst (Gruppe fahnas) erreicht die Sockets.
#  - RuntimeDirectoryPreserve=yes: /run/fahnas bleibt bei Neustarts des Agenten bestehen – der Web-Dienst hat den Ordner
#    über ReadWritePaths in seinem Namensraum eingebunden; würde er gelöscht und neu angelegt, sähe der Web-Dienst ins Leere.
#  - NotifyAccess=all: der Agent meldet „bereit“ über das Hilfsprogramm systemd-notify (eigener Prozess), nicht aus dem Haupt-PID.
#  - KEINE Option, die einen eigenen Mount-Namensraum erzeugt (ProtectKernelLogs, ProtectClock, Private*, Protect{System,Home,…},
#    Read*/Inaccessible*Paths, MountFlags …): der Agent hängt externe Laufwerke ein. In einem eigenen Namensraum (systemd
#    macht ihn zum Abhängigen des Hosts) blieben diese Einhängungen unsichtbar – Samba, Apps und das System sahen nur leere
#    Ordner (Betreiber-Fund 26.09., Ventoy-Stick). tests/einheit/nutzerwechsel.test.js wacht darüber.

[Unit]
Description=FAH-NAS Steuerdienst (Agent)
Documentation=file:/opt/fahnas/README.md
After=network-online.target smbd.service local-fs.target
Wants=network-online.target
RequiresMountsFor=/data/config /data/shares

[Service]
Type=simple
User=root
Group=fahnas
WorkingDirectory=/opt/fahnas
ExecStart=/usr/bin/node /opt/fahnas/src/agent/agent.js
# UGREEN-Gehäuse: Lüfter auch nach einem Absturz an das BIOS zurückgeben (ohne gesicherten Zustand: nichts zu tun)
ExecStopPost=-/usr/bin/node /opt/fahnas/src/agent/hardware/luefter-bios.js
Environment=NODE_ENV=production
Environment=FAHNAS_CONFIG=/data/config
Environment=FAHNAS_RUN=/run/fahnas
RuntimeDirectory=fahnas
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=30
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fahnas-agent
# Vertretbare Härtung ohne Nebenwirkung auf die Root-Aufgaben (nur seccomp/Adressfamilien, kein Namensraum):
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
