# fahnas-watchdog: Hardware-Watchdog der UGREEN-DXP-Gehäuse sehr früh im Start übernehmen (tools/watchdog_halten.py) –
# vor dem Erststart und allen Diensten, damit ein vom BIOS gestarteter Watchdog das NAS nicht nach drei Minuten
# zurücksetzt. Auf anderen Geräten tut das Skript nichts. Der Installer aktiviert die Unit, der Agent prüft sie.

[Unit]
Description=FAH-NAS Hardware-Watchdog übernehmen (UGREEN DXP)
DefaultDependencies=no
After=systemd-modules-load.service local-fs.target
Before=sysinit.target fahnas-erststart.service fahnas-agent.service
ConditionPathExists=/sys/class/dmi/id/product_name

[Service]
Type=oneshot
RemainAfterExit=yes
# Neuer Stand aus dem Release, beim ersten Start (vor dem Erststart) die Kopie vom Installationsmedium
ExecStart=/bin/sh -c 'for f in /opt/fahnas/tools/watchdog_halten.py /opt/fahnas-install/watchdog_halten.py; do [ -f "$f" ] && exec /usr/bin/python3 "$f"; done; exit 0'
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fahnas-watchdog

[Install]
WantedBy=sysinit.target
