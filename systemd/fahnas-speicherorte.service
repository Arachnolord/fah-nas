# fahnas-speicherorte: hängt Docker/Apps/VMs auf einem übernommenen Volume ein (Speicherorte), bevor Docker und libvirt
# starten. Aktiviert wird die Unit vom Agenten erst, wenn ein Speicherort gewählt ist; Docker/libvirt bekommen dann ein
# Drop-in mit Requires=/After= auf diese Unit. Ohne Einstellung endet sie sofort.

[Unit]
Description=FAH-NAS Speicherorte (Docker/Apps/VMs auf übernommenem Volume)
Documentation=file:/opt/fahnas/README.md
After=local-fs.target systemd-udevd.service
Before=docker.service containerd.service libvirtd.service fahnas-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/node /opt/fahnas/src/agent/import/speicherorte-start.js
Environment=FAHNAS_CONFIG=/data/config
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fahnas-speicherorte

[Install]
WantedBy=multi-user.target
