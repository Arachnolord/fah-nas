# fahnas-web: Oberfläche und JSON-API ohne eigene Rechte (Nutzer fahnas). Alles Schreibende geht über den Agenten.
# Braucht lesend: /opt/fahnas (Programm, public/), /data/config/system.json (0640 root:fahnas – deshalb Gruppe fahnas),
# /proc und /sys (Messwerte). Schreibend nur /data/config/web (Sitzungen, TLS-Zertifikat, Bremse, Web-Protokoll) und
# /run/fahnas (Verbindung zu den Sockets des Agenten). Port 8443 (seit 0.6.17; 80/443 gehören FAH-Proxy, damit Geräte im
# Haus und im VPN die Domains direkt erreichen – Betreiber 09.10.). Keine Umleitung von Port 80 mehr (FAHNAS_HTTP_PORT leer).
# Bewusst NICHT gesetzt: MemoryDenyWriteExecute (Node-JIT braucht ausführbaren Speicher) und SystemCallFilter (Node
# braucht eine breite Menge an Systemaufrufen; ein zu enger Filter äußert sich als stiller Absturz).
# NotifyAccess=all: „bereit“ kommt über das Hilfsprogramm systemd-notify.

[Unit]
Description=FAH-NAS Weboberfläche
Documentation=file:/opt/fahnas/README.md
After=fahnas-agent.service network-online.target
Requires=fahnas-agent.service
Wants=network-online.target
RequiresMountsFor=/data/config

[Service]
Type=simple
User=fahnas
Group=fahnas
SupplementaryGroups=fahnas
WorkingDirectory=/opt/fahnas
ExecStart=/usr/bin/node /opt/fahnas/src/web/web.js
Environment=NODE_ENV=production
Environment=FAHNAS_CONFIG=/data/config
Environment=FAHNAS_RUN=/run/fahnas
Environment=FAHNAS_WEB_PORT=8443
Environment=FAHNAS_HTTP_PORT=
Restart=always
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fahnas-web

# Rechte
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Dateisystem
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data/config/web /run/fahnas
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=all

# Sonstiges
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
