# fahnas.target: fasst Steuerdienst und Weboberfläche zusammen (systemctl restart fahnas.target startet beide neu).
# Die Dienste hängen selbst an multi-user.target; dieses Ziel ist nur Bequemlichkeit.

[Unit]
Description=FAH-NAS Steuerzentrale (Agent + Weboberfläche)
Wants=fahnas-agent.service fahnas-web.service
After=fahnas-agent.service fahnas-web.service

[Install]
WantedBy=multi-user.target
