# FAH-NAS: Ubuntu Server 26.04 LTS unbeaufsichtigt installieren (Autoinstall v1, subiquity).
# Interaktiv ist nur „identity“ (Name, Rechnername, Benutzer, Passwort). Sobald interactive-sections gesetzt ist, gilt
# der Installer als interaktiv und verlangt ZWEI weitere Tastendrücke: „Confirm destructive action“ vor dem Schreiben
# auf die Platte und „Reboot Now“ am Ende (subiquity install.py: Auto-Bestätigung nur bei not interactive + „autoinstall“
# auf der Kernelzeile; shutdown.py: interaktiv wartet auf user_shutdown_event – der Schlüssel „shutdown“ ändert daran
# nichts). Kein Autoinstall-Schlüssel schaltet das ab; die Alternative (feste identity, kein Dialog) hätte bis zur
# Ersteinrichtung kein bekanntes Konsolen-/SSH-Passwort – deshalb bewusst dokumentiert statt umgebaut (iso/README.md).
# Die Zielplatte und die Übernahme einer
# vorhandenen Datenpartition entscheidet platte_waehlen.sh in den early-commands: subiquity liest /autoinstall.yaml
# nach den early-commands erneut ein (Doku „early-commands“: „the file is re-read after the early-commands have run to
# allow them to alter the configuration if necessary“) – das Skript ersetzt dort die storage-Sektion unten.
# Die storage-Sektion hier ist die lesbare Vorlage für den Normalfall (UEFI, leere Platte) mit zwei Platzhaltern:
# FAHNAS_ZIELPLATTE (Gerätepfad) und FAHNAS_DATEN_GROESSE (Rest der Platte in Byte). Ohne early-commands würde curtin
# an den Platzhaltern scheitern – so kann nie versehentlich die falsche Platte gelöscht werden.
autoinstall:
  version: 1
  interactive-sections:
    - identity
  locale: de_DE.UTF-8
  keyboard:
    layout: de
  timezone: Europe/Berlin
  refresh-installer:
    update: false
  source:
    id: ubuntu-server
    search_drivers: false
  ssh:
    install-server: true
    allow-pw: true
  # Netz: DHCP auf allen Kabelschnittstellen; zusätzlich zu den DNS-Servern aus DHCP feste Rückfälle (1.1.1.1, 8.8.8.8).
  # Grund: In einer VM mit macvtap ist der DHCP-DNS oft der eigene Host und unerreichbar – der Installer hinge dann bei
  # „curtin command apt-config“, der Erststart fände keine Pakete. curtin übernimmt die Konfiguration ins installierte System.
  network:
    version: 2
    ethernets:
      fahnas-alle:
        match:
          name: "e*"
        dhcp4: true
        nameservers:
          addresses: [1.1.1.1, 8.8.8.8]
  updates: security
  # Spiegel nicht erreichbar? Dann vom Medium fertig installieren statt zu hängen. platte_waehlen.sh entfernt in
  # diesem Fall auch die packages-Liste (sonst bricht der Installer dort ab), der Erststart holt die Pakete nach.
  apt:
    fallback: offline-install
  # grub-btrfs gibt es nicht als Ubuntu-Paket → baut der Erststart aus dem geprüften Quellarchiv ein (quellen.env).
  packages:
    - samba
    - samba-vfs-modules
    - avahi-daemon
    - btrfs-progs
    - snapper
    - inotify-tools
    # Spiegelung (0.7.0): einseitig rsync, beidseitig unison
    - rsync
    - unison
    # Spiegelung mit anderen NAS (0.8.0): SMB einhängen und Freigaben auflisten
    - cifs-utils
    - smbclient
    # VPN-Server (0.11.0): WireGuard + QR-Codes für die Geräte
    - wireguard-tools
    - qrencode
    - nodejs
    - docker.io
    - docker-compose-v2
    - docker-buildx
    - qemu-system-x86
    - libvirt-daemon-system
    - libvirt-clients
    - virtinst
    - zram-tools
    - smartmontools
    - lm-sensors
    - hdparm
    - nftables
    # Weltkarte (Übersicht): Verbindungstabelle des Kernels lesen
    - conntrack
    - iproute2
    - zip
    - unzip
    - acl
    - attr
    - openssl
    - curl
    - tar
    - zstd
    # Externe Laufwerke (§12): Treiber/Werkzeuge für NTFS, exFAT, FAT, ext*, xfs, HFS+ und sicheres Auswerfen
    - ntfs-3g
    - exfatprogs
    - dosfstools
    - e2fsprogs
    - xfsprogs
    - hfsprogs
    - udisks2
    - ffmpeg
    # Umstieg von UGOS & Co. (0.24.0): fremde RAIDs und Volume-Gruppen übernehmen, UGREEN-Gehäuse-LEDs
    - mdadm
    - lvm2
    - i2c-tools
    - gdisk
  early-commands:
    # UGREEN DXP: vom BIOS gestarteten Hardware-Watchdog übernehmen, sonst setzt er den Installer nach 3 Minuten zurück
    - python3 /cdrom/fahnas/watchdog_halten.py || true
    - bash /cdrom/fahnas/dns_rueckfall.sh
    - bash /cdrom/fahnas/platte_waehlen.sh
  storage:
    version: 2
    swap:
      size: 0
    config:
      - type: disk
        id: fahnas-platte
        path: FAHNAS_ZIELPLATTE
        ptable: gpt
        wipe: superblock-recursive
        preserve: false
        grub_device: false
        name: ''
      - type: partition
        id: fahnas-p1
        device: fahnas-platte
        number: 1
        size: 1073741824
        flag: boot
        grub_device: true
        wipe: superblock
        preserve: false
      - type: format
        id: fahnas-f1
        volume: fahnas-p1
        fstype: fat32
        label: FAHNAS-EFI
        preserve: false
      - type: mount
        id: fahnas-m1
        device: fahnas-f1
        path: /boot/efi
      - type: partition
        id: fahnas-p2
        device: fahnas-platte
        number: 2
        size: 8589934592
        flag: swap
        wipe: superblock
        preserve: false
      - type: format
        id: fahnas-f2
        volume: fahnas-p2
        fstype: swap
        label: FAHNAS-SWAP
        preserve: false
      - type: partition
        id: fahnas-p3
        device: fahnas-platte
        number: 3
        size: 51539607552
        wipe: superblock
        preserve: false
      - type: format
        id: fahnas-f3
        volume: fahnas-p3
        fstype: btrfs
        label: FAHNAS-SYSTEM
        preserve: false
      - type: mount
        id: fahnas-m3
        device: fahnas-f3
        path: /
      - type: partition
        id: fahnas-p4
        device: fahnas-platte
        number: 4
        size: FAHNAS_DATEN_GROESSE
        wipe: superblock
        preserve: false
      - type: format
        id: fahnas-f4
        volume: fahnas-p4
        fstype: btrfs
        label: FAHNAS-DATEN
        preserve: false
  late-commands:
    # Unterlaufwerke anlegen, Wurzel nach @ verschieben, fstab schreiben, GRUB neu (läuft in der Installer-Umgebung)
    - bash /cdrom/fahnas/partitionen.sh
    # Erststart-Paket ins Ziel kopieren und den Dienst aktivieren
    - mkdir -p /target/opt/fahnas-install
    - cp -r /cdrom/fahnas/. /target/opt/fahnas-install/
    - chmod 755 /target/opt/fahnas-install/erststart.sh /target/opt/fahnas-install/partitionen.sh /target/opt/fahnas-install/platte_waehlen.sh
    - cp /cdrom/fahnas/fahnas-erststart.service /target/etc/systemd/system/fahnas-erststart.service
    - curtin in-target --target=/target -- systemctl enable fahnas-erststart.service
    # Hardware-Watchdog (UGREEN DXP) schon beim ersten Start vor dem Erststart übernehmen
    - cp /cdrom/fahnas/fahnas-watchdog.service /target/etc/systemd/system/fahnas-watchdog.service
    - curtin in-target --target=/target -- systemctl enable fahnas-watchdog.service
  error-commands:
    - cat /var/log/fahnas-platte.log 2>/dev/null || true
    - cat /var/log/fahnas-partitionen.log 2>/dev/null || true
