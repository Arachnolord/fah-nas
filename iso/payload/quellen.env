# Festgenagelte Fremdquellen, die es in Ubuntu 26.04 nicht als Paket gibt. Wird von iso/build_iso.sh (Herunterladen
# in den Cache, Prüfsumme) und iso/payload/erststart.sh (Einbau auf dem Zielsystem, Prüfsumme) gelesen.
# Format: nur VARIABLE=Wert, keine Befehle – beide Skripte lesen die Datei mit „. quellen.env“.

# grub-btrfs: Schnappschüsse im GRUB-Startmenü (https://github.com/Antynea/grub-btrfs, GPL-3.0).
# Kein Paket in Ubuntu (packages.ubuntu.com, alle Suites, geprüft 25.09.2026). Quellarchiv des Release-Tags.
GRUB_BTRFS_VERSION=4.14
GRUB_BTRFS_URL=https://github.com/Antynea/grub-btrfs/archive/refs/tags/v4.14.tar.gz
GRUB_BTRFS_DATEI=grub-btrfs-4.14.tar.gz
GRUB_BTRFS_SHA256=4fe2f8a49b39e3e561fc51bbc5a0f81a7222c1e9ef8672e014e0ba3bedad20c6
