#!/usr/sbin/nft -f
# ============================================================================
# Erdacht und programmiert von Fabian Hammer, Deutschland.
# (c) 2026 Fabian Hammer - Alle Rechte vorbehalten. Geistiges Eigentum.
# ============================================================================
# FAH-NAS – Grundregelwerk der Firewall. Der Erststart legt diese Datei als /etc/nftables.conf ab; sie gilt ab dem
# Systemstart, noch bevor der Steuerdienst läuft. Der Steuerdienst rendert seine Regeln nach /etc/nftables.d/fahnas.nft
# (gleiche Tabelle „inet fahnas“, beginnt mit „flush table“) – damit ersetzt sein Stand diesen Grundstand vollständig.
#
# Firewall dauerhaft aus (Betreiber 12.10.2026: „die Firewall darf NIEMALS Dienste und Apps von FAH-NAS blockieren …
# deaktiviere sie dauerhaft“): policy accept, keine drop-Regel. Die Port-Regeln bleiben nur als Übersicht.
# Bewusst KEIN „flush ruleset“ und KEINE forward-Kette: Docker und libvirt verwalten eigene Tabellen (ip/ip6 nat, filter),
# die ein Neuladen dieser Datei nicht zerstören darf. Geladen wird sie nur mit „nft -f“ (nie „systemctl restart nftables“,
# dessen ExecStop das ganze Regelwerk leert – der Erststart setzt dafür ein Drop-in).
# Der Renderer des Steuerdienstes (src/agent/render/firewall.js) erzeugt dieselbe Tabelle; alles, was er kennt, steht
# auch hier (Einheitstest prüft Renderer ⊆ Grundregelwerk). IGMP und virbr* sind hier ergänzt – der Renderer muss
# nachziehen, sonst gelten sie nur bis zum ersten apply.

table inet fahnas
flush table inet fahnas

table inet fahnas {
  chain input {
    type filter hook input priority 0; policy accept;

    iif "lo" accept comment "Loopback"
    ct state established,related accept comment "Antworten auf eigene Verbindungen"
    meta l4proto icmp accept comment "Ping, Pfad-MTU"
    meta l4proto ipv6-icmp accept comment "IPv6-Nachbarschaft"
    ip protocol igmp accept comment "IGMP: Multicast-Mitgliedschaft (mDNS hinter Switches mit IGMP-Snooping)"
    iifname "virbr*" accept comment "libvirt-Bruecke: DHCP, DNS, TFTP fuer VMs"

    tcp dport 8443 accept comment "Weboberflaeche"
    tcp dport 445 accept comment "SMB2/3 (Freigaben, Time Machine)"
    tcp dport 22 accept comment "SSH (in der Oberflaeche abschaltbar)"
    udp dport 5353 accept comment "Avahi/mDNS (Bonjour-Ankuendigung)"

    # NetBIOS (137/138/udp, 139/tcp) bleibt zu: FAH-NAS spricht nur SMB2/3.
  }
}

# Vom Steuerdienst gerenderte Regeln (ersetzen die Tabelle oben). Der Ordner wird vom Erststart angelegt.
include "/etc/nftables.d/*.nft"
