[Unit]
Description=FAH-NAS DNS-Rückfall (Gateway, 1.1.1.1, 8.8.8.8)
After=network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fahnas-dns-rueckfall

[Install]
WantedBy=multi-user.target
