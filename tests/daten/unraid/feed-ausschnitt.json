  {
   "Name": "brigata-studio2go",
   "Repository": "ghcr.io/0xc/brigata-studio2go:latest",
   "Registry": "https://ghcr.io/0xc/brigata-studio2go",
   "TemplateURL": "https://raw.githubusercontent.com/0xC/brigata-studio2go-unraid/main/brigata-studio2go.xml",
   "Network": "bridge",
   "Privileged": "false",
   "Support": "https://github.com/0xC/brigata-studio2go-unraid/issues",
   "Project": "https://github.com/0xC/brigata-studio2go",
   "Overview": "A private, self-hosted Brigata AI agent + Studio that runs entirely on your Unraid box. No cloud dependency and no inbound connection required — you reach it on your LAN. The only outbound traffic is to the Anthropic API for the model (your key). Password login; embedded Postgres persisted to appdata.",
   "WebUI": "http://[IP]:[PORT:3030]/",
   "Icon": "https://brigata.ai/favicon.png",
   "Networking": {
    "Mode": "bridge"
   },
   "Config": [
    {
     "@attributes": {
      "Name": "WebUI Port",
      "Target": "3030",
      "Default": "3030",
      "Mode": "tcp",
      "Description": "Port the Studio web UI + API listen on",
      "Type": "Port",
      "Display": "always",
      "Required": "true",
      "Mask": "false"
     },
     "value": "3030"
    },
    {
     "@attributes": {
      "Name": "Data (Postgres + config)",
      "Target": "/var/lib/postgresql",
      "Default": "/mnt/user/appdata/brigata-studio2go",
      "Mode": "rw",
      "Description": "Persistent data — the embedded database and generated config. Survives updates.",
      "Type": "Path",
      "Display": "always",
      "Required": "true",
      "Mask": "false"
     },
     "value": "/mnt/user/appdata/brigata-studio2go"
    },
    {
     "@attributes": {
      "Name": "Admin password",
      "Target": "STANDALONE_ADMIN_PASSWORD",
      "Default": "",
      "Mode": "",
      "Description": "The login password for the admin user (set on first boot)",
      "Type": "Variable",
      "Display": "always",
      "Required": "true",
      "Mask": "true"
     },
     "value": ""
    },
    {
     "@attributes": {
      "Name": "Anthropic API key",
      "Target": "ANTHROPIC_API_KEY",
      "Default": "",
      "Mode": "",
      "Description": "sk-ant-api03-... or sk-ant-oat01-... — used only when the agent runs",
      "Type": "Variable",
      "Display": "always",
      "Required": "true",
      "Mask": "true"
     },
     "value": ""
    },
    {
     "@attributes": {
      "Name": "Homelab access (optional)",
      "Target": "/mnt/user",
      "Default": "/mnt/user",
      "Mode": "rw",
      "Description": "OPTIONAL: mount your shares so the agent can read/manage files (e.g. Frigate config). Remove to keep it isolated.",
      "Type": "Path",
      "Display": "advanced",
      "Required": "false",
