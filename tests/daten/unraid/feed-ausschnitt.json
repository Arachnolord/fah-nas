  {
   "Name": "Lansweeper-Network-Discovery",
   "Repository": "ghcr.io/007darkmatter5/lansweeper-network-discovery:latest",
   "Registry": "https://github.com/007darkmatter5/lansweeper-network-discovery/pkgs/container/lansweeper-network-discovery",
   "Branch": {
    "Tag": "latest",
    "TagDescription": "Latest Hub and IT Sensor release from Lansweeper"
   },
   "Network": "host",
   "Shell": "bash",
   "Privileged": "false",
   "Support": "https://github.com/007darkmatter5/lansweeper-network-discovery/issues",
   "Project": "https://github.com/007darkmatter5/lansweeper-network-discovery",
   "ReadMe": "https://github.com/007darkmatter5/lansweeper-network-discovery#readme",
   "TemplateURL": "https://raw.githubusercontent.com/007darkmatter5/unraid-templates/main/templates/lansweeper-network-discovery.xml",
   "Icon": "https://raw.githubusercontent.com/007darkmatter5/lansweeper-network-discovery/main/docs/icon.png",
   "WebUI": "https://[IP]:[PORT:59525]/",
   "Overview": "Unofficial container for Lansweeper Network Discovery. It runs the Hub and the IT Sensor\n    together: the sensor scans your network, and the Hub sends what it finds to your\n    Lansweeper Site. Not affiliated with or supported by Lansweeper.\n\n    The image installs the official Linux packages from Lansweeper's apt repository when it\n    is built, and is rebuilt when Lansweeper releases a new version.\n\n    To link it to your Site, paste the linking code from your Site (Discovery > Discovery\n    systems > Link discovery system) into Linking Code, or link it from the web UI after\n    the first start. The web UI uses a self-signed certificate.\n\n    First start: open https://your-server:59526/ (the Setup Port) and set the admin\n    password. The Hub only allows this from the server itself, so the container relays that\n    port locally until the password is set, then closes it. After that, use the WebUI link.\n\n    Host networking is required for discovery to see your LAN. Keep appdata on cache or an\n    SSD: the Hub uses a SQLite database, and SQLite over a network share is unreliable.",
   "ExtraSearchTerms": "lansweeper asset inventory network discovery scanner itam",
   "ExtraParams": "--cap-add=NET_RAW --cap-add=NET_ADMIN --stop-timeout=60",
   "Requires": "A Lansweeper Site (https://app.lansweeper.com). amd64 only.",
   "Date": "2026-09-24",
   "Config": [
    {
     "@attributes": {
      "Name": "App Data",
      "Target": "/config",
      "Default": "/mnt/user/appdata/lansweeper-network-discovery",
      "Mode": "rw",
      "Description": "Hub database, certificate, settings and logs, and the sensor's settings. Put this on cache or an SSD.",
      "Type": "Path",
      "Display": "always",
      "Required": "true",
      "Mask": "false"
     },
     "value": "/mnt/user/appdata/lansweeper-network-discovery"
    },
    {
     "@attributes": {
      "Name": "Linking Code",
      "Target": "LINKING_CODE",
      "Default": "",
      "Mode": "",
      "Description": "Optional. Linking code from your Lansweeper Site. Applied once; changing it applies the new code. Leave empty to link from the web UI instead.",
      "Type": "Variable",
      "Display": "always",
      "Required": "false",
      "Mask": "true"
     },
     "value": ""
    },
    {
     "@attributes": {
      "Name": "Hub HTTPS Port",
      "Target": "HUB_PORT",
      "Default": "59525",
      "Mode": "",
      "Description": "Port for the Hub web UI and the sensor connection. With host networking this is the port on the server.",
      "Type": "Variable",
      "Display": "always",
      "Required": "true",
      "Mask": "false"
     },
     "value": "59525"
    },
    {
     "@attributes": {
      "Name": "Setup Port",
      "Target": "SETUP_PORT",
      "Default": "59526",
      "Mode": "",
      "Description": "Open https://your-server:59526/ once to set the admin password. The port is only open until the password is set. Set to 0 to disable it.",
      "Type": "Variable",
      "Display": "always",
      "Required": "false",
      "Mask": "false"
     },
     "value": "59526"
    },
    {
     "@attributes": {
      "Name": "Passive Only",
      "Target": "PASSIVE_ONLY",
      "Default": "",
      "Mode": "",
      "Description": "Leave empty to use active scanning on first start and keep whatever you set in the Hub UI after that. true = listen passively only, false = active scanning.",
      "Type": "Variable",
      "Display": "advanced",
      "Required": "false",
      "Mask": "false"
     },
     "value": ""
    },
    {
     "@attributes": {
      "Name": "Enable IT Sensor",
      "Target": "ENABLE_SENSOR",
      "Default": "true",
      "Mode": "",
      "Description": "Run the IT Sensor alongside the Hub. Set to false for a Hub only.",
      "Type": "Variable",
      "Display": "advanced",
      "Required": "false",
      "Mask": "false"
     },
     "value": "true"
    },
    {
     "@attributes": {
      "Name": "Hub Code",
      "Target": "HUB_CODE",
      "Default": "",
      "Mode": "",
      "Description": "Optional. Hub code for pairing the sensor, if the Hub UI asks for one.",
      "Type": "Variable",
      "Display": "advanced",
      "Required": "false",
      "Mask": "true"
     },
     "value": ""
    },
    {
     "@attributes": {
      "Name": "Hub Hostname",
